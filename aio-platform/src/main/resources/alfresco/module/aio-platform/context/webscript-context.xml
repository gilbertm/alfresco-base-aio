<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- HelloUniverse CRUD API — base bean with service injection -->
    <bean id="webscript.alfresco.tutorials.hellouniverse.base"
          class="ae.ac.cud.tutorials.HelloUniverseBase"
          abstract="true">
        <property name="nodeService" ref="NodeService" />
        <property name="namespaceService" ref="NamespaceService" />
        <property name="searchService" ref="SearchService" />
    </bean>

    <!-- GET /sample/hellouniverse — list all records -->
    <bean id="webscript.alfresco.tutorials.hellouniverse-list.get"
          class="ae.ac.cud.tutorials.HelloUniverseList"
          parent="webscript.alfresco.tutorials.hellouniverse.base" />

    <!-- GET /sample/hellouniverse/node?id={id} — get one record -->
    <bean id="webscript.alfresco.tutorials.hellouniverse.get"
          class="ae.ac.cud.tutorials.HelloUniverseGet"
          parent="webscript.alfresco.tutorials.hellouniverse.base" />

    <!-- POST /sample/hellouniverse — create a record -->
    <bean id="webscript.alfresco.tutorials.hellouniverse.post"
          class="ae.ac.cud.tutorials.HelloUniverseCreate"
          parent="webscript.alfresco.tutorials.hellouniverse.base" />

    <!-- PUT /sample/hellouniverse/node?id={id} — update a record -->
    <bean id="webscript.alfresco.tutorials.hellouniverse.put"
          class="ae.ac.cud.tutorials.HelloUniverseUpdate"
          parent="webscript.alfresco.tutorials.hellouniverse.base" />

    <!-- DELETE /sample/hellouniverse/node?id={id} — delete a record -->
    <bean id="webscript.alfresco.tutorials.hellouniverse.delete"
          class="ae.ac.cud.tutorials.HelloUniverseDelete"
          parent="webscript.alfresco.tutorials.hellouniverse.base" />

    <!-- ============================================================
          CUD Customs — User Seed API
          ============================================================
          POST /custom/seed-users — reads bundled Excel from classpath
          for batch registration (no external file upload required)
          ============================================================ -->

    <bean id="webscript.alfresco.customs.users-seed.post"
          class="ae.ac.cud.customs.UserSeedPost">
        <property name="nodeService" ref="NodeService" />
        <property name="personService" ref="PersonService" />
        <property name="authenticationService" ref="AuthenticationService" />
        <property name="namespaceService" ref="NamespaceService" />
    </bean>

</beans>
